<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:padding="4dp">
        <Button android:id="@+id/btnSettings" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙ הגדרות" />
        <Button android:id="@+id/btnPlayback" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏪ הקלטות" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/btnPrev" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" />
        <TextView android:id="@+id/pageLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/btnNext" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹" android:textSize="22sp" />
    </LinearLayout>
    <GridLayout android:id="@+id/grid" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layoutDirection="ltr" />
</LinearLayout>
