<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp" android:layoutDirection="rtl">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="הגדרות NVR" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="#AAAAAA"
        android:text="מהבית: הכנס את כתובת ה-IP המקומית (למשל 192.168.1.64). מחוץ לבית: הכנס כתובת DDNS / IP חיצוני, או התחבר ל-VPN של הבית והשתמש בכתובת המקומית." />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="כתובת (IP או DDNS)" />
    <EditText android:id="@+id/etHost" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textUri" android:textDirection="ltr" android:hint="192.168.1.64" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="פורט RTSP" />
    <EditText android:id="@+id/etPort" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="number" android:textDirection="ltr" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="שם משתמש" />
    <EditText android:id="@+id/etUser" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="text" android:textDirection="ltr" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="סיסמה" />
    <EditText android:id="@+id/etPass" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textPassword" android:textDirection="ltr" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="מספר מצלמות ב-NVR" />
    <EditText android:id="@+id/etChannels" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="number" android:textDirection="ltr" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="תצוגה במסך הראשי" />
    <Spinner android:id="@+id/spGrid" android:layout_width="match_parent" android:layout_height="48dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="יצרן" />
    <Spinner android:id="@+id/spBrand" android:layout_width="match_parent" android:layout_height="48dp" />
    <Button android:id="@+id/btnDetect" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔍 זהה יצרן אוטומטית" />
    <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/probeView"
        android:layout_width="1dp" android:layout_height="1dp" />
    <TextView android:id="@+id/tplLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="תבנית RTSP. משתנים: {host} {port} {ch} {ch2}=01 {stream}=0 ראשי / 1 משני" />
    <EditText android:id="@+id/etTemplate" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textUri" android:textDirection="ltr" />
    <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="שמירה" />
</LinearLayout>
</ScrollView>
